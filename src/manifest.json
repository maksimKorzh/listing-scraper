{
    "manifest_version": 3,
    "name": "Web Scraper",
    "version": "1.0",
    "permissions": [
        "storage",
        "tabs"
    ],
    "action": {
        "default_popup": "menu.html"
    },
    "host_permissions": [
        "<all_urls>"
    ],
    "content_scripts": [
    {
        "matches": ["<all_urls>"],
        "js": [
            "scraper.js",
            "ui.js"
        ],
        "run_at": "document_idle"
    }
  ]
}